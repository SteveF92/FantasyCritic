; Reference systemd unit for the web app after Phase 1 of the deployment modernization.
;
; Two things changed from the pre-Phase-1 unit:
;   1. Paths go through /opt/fantasy-critic/current, a symlink the deploy script repoints.
;      systemd resolves it at start time, so a rollback is a symlink swap plus a restart.
;   2. ExecStart runs the published binary directly instead of `dotnet FantasyCritic.Web.dll`,
;      because the bundle is published self-contained and there is no dotnet on the box.
;
; Install with:
;   sudo cp infrastructure/fantasy-critic.service /etc/systemd/system/fantasy-critic.service
;   sudo systemctl daemon-reload
;
; Reconcile the User/Group and any extra Environment lines with whatever the existing unit
; on the instance already has before overwriting it:
;   systemctl cat fantasy-critic.service

[Unit]
Description=Fantasy Critic
After=network.target

[Service]
WorkingDirectory=/opt/fantasy-critic/current/web
ExecStart=/opt/fantasy-critic/current/web/FantasyCritic.Web
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=fantasy-critic

User=www-data
Group=www-data

; nginx proxies to this; see infrastructure/api_proxy.conf.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
; Beta uses Staging, which Program.cs maps to the "beta" secret in Secrets Manager.
; deploy.sh reads this value back out of the unit to run the migrator against the same
; environment, so it must be set here.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

; The app writes rolling Serilog files here and user content under /var/lib.
ReadWritePaths=/var/log/fantasy-critic /var/lib/fantasy-critic

[Install]
WantedBy=multi-user.target
