{
  "semi": true,
  "singleQuote": true,
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 200,
  "vueIndentScriptAndStyle": false,
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "ignore",
  "bracketSameLine": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["^vue$", "^(vue-router|pinia)$", "<THIRD_PARTY_MODULES>", "", "^@/api/", "^@/(store|utilities|globalFunctions|models)", "^@/", "", "^[./]"]
}
