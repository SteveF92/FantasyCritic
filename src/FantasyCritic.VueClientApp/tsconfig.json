{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler", // Resolves imports the way Vite does
    "strict": true,
    "esModuleInterop": true, // Default imports from CommonJS modules
    "skipLibCheck": true, // Don't type-check packages' declaration files
    "allowImportingTsExtensions": true,
    "noEmit": true, // Vite compiles; TypeScript only type-checks (npm run type-check)
    "paths": {
      "@/*": ["./src/*"] // The `@` alias in vite.config.js
    },
    "lib": ["dom", "esnext"],
    "types": ["vite/client"]
  },
  "vueCompilerOptions": {
    // Unknown components, events and directives in templates are errors, not silent `any`s
    "checkUnknownComponents": true,
    "checkUnknownEvents": true,
    "checkUnknownDirectives": true
  },
  "include": [
    "components.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
