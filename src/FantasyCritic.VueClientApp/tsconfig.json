{
  "compilerOptions": {
    // Aligns with modern JavaScript while retaining compatibility
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler", // Resolves imports the way Vite does
    "strict": true, // Start with relaxed settings for gradual migration
    "esModuleInterop": true, // Enables better compatibility with CommonJS modules
    "skipLibCheck": true, // Speeds up compilation by skipping type checks of declaration files
    "allowSyntheticDefaultImports": true, // Enables default import syntax
    "allowImportingTsExtensions": true, // Enables importing .ts files as modules
    "sourceMap": true, // Useful for debugging in Vite
    "noEmit": true, // Vite compiles; TypeScript only type-checks (npm run type-check)
    "paths": {
      "@/*": ["./src/*"] // Matches Vite's default alias for `src`
    },
    "lib": ["dom", "esnext"], // Adds DOM and modern JS features
    // Vite's typings, plus the annotation plugin's additions to Chart.js's options (it is
    // registered in main.js, which is outside this program)
    "types": ["vite/client", "chartjs-plugin-annotation"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
