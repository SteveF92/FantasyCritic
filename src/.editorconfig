root = true

# Baseline: whitespace only. Format.ps1 applies these via `dotnet format whitespace`.
# To adopt a C# style rule incrementally, add it under [*.cs] at :warning (or higher),
# run `scripts/Format.ps1 -Style`, commit the rule + resulting code changes, repeat.

[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.csproj]
indent_size = 2

[*.cs]
indent_size = 4

# Style rules (uncomment one at a time, set :warning, run scripts/Format.ps1 -Style):
# dotnet_diagnostic.IDE0005.severity = warning
# csharp_style_namespace_declarations = file_scoped:warning
# csharp_prefer_braces = true:warning

[*.{js,json,vue}]
indent_size = 2
