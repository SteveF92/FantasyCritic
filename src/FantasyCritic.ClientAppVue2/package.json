{
  "name": "fantasy-critic-client-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node aspnetcore-https",
    "start": "vite",
    "client": "vite -c vite.client.config.js",
    "build": "vite build -c vite.build.config.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@microsoft/signalr": "^8.0.17",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.3",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "html2canvas": "^1.4.1",
    "luxon": "^3.7.2",
    "pinia": "~2.3.1",
    "vee-validate": "^4.15.1",
    "vue": "3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^4.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
