{
  "name": "fantasy-critic-client-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "node aspnetcore-https",
    "start": "vite",
    "client": "vite -c vite.client.config.js",
    "build": "vite build -c vite.build.config.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@microsoft/signalr": "^8.0.17",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vue/compat": "3.5.44",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^1.2.2",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "html2canvas": "^1.4.1",
    "luxon": "^3.7.2",
    "pinia": "~2.3.1",
    "vee-validate": "^4.15.1",
    "vue": "3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^4.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "portal-vue": {
      "vue": "$vue"
    }
  }
}
